# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DODO_PAYMENTS_API_KEY: Used to process bid payments.
DODO_PAYMENTS_API_KEY="test_sk_..."

# ADMIN_EMAIL: Recipient of approval / rejection requests (Default: princemrb89@gmail.com)
ADMIN_EMAIL="princemrb89@gmail.com"

# Direct Gmail Dispatch (Recommended for sending to any real @gmail.com address without domain verification)
# 1. Enable 2-Step Verification in your Google Account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASS=""

# Resend API Key (Note: Free Resend test mode only delivers to your registered Resend account email unless a custom domain is verified at resend.com/domains)
RESEND_API_KEY=""

# Custom SMTP Configuration (SendGrid, Mailgun, Postmark, AWS SES)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="JustBid Notifications <onboarding@resend.dev>"

# Supabase Authentication Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
